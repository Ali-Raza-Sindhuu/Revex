PORT=4000
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=revex

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
GOOGLE_CLIENT_ID=your-google-oauth-client-id

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

EMAIL_MODE=console
RESEND_API_KEY=your-resend-api-key
MAIL_FROM=REVEX <noreply@example.com>
FRONTEND_URL=http://localhost:5173

# Stripe test mode: use the secret key from your Stripe Dashboard and a webhook
# signing secret for POST /api/payments/webhook. Never expose the secret key to the frontend.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CURRENCY=usd

# Set this to the deployed frontend origin when deploying the API. Cloudinary
# credentials above and JWT_SECRET are required when the application starts.
